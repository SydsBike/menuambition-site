---
// Person card (spec §5): photo state or gray-placeholder state.
// Pass `photo` (an imported image) for a real headshot; omit it to fall back
// to the gray circular avatar. Swapping a placeholder for a photo later is a
// one-line change at the call site (add the `photo` prop).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  title: string;
  photo?: ImageMetadata;
  /** CSS object-position for the photo crop (landscape sources need a bias). */
  photoPosition?: string;
}

const { name, title, photo, photoPosition = 'center 25%' } = Astro.props;
---
<article class="person-card">
  {photo ? (
    <Image
      class="person-card__avatar person-card__avatar--photo"
      src={photo}
      alt={`Portrait of ${name}`}
      width={640}
      style={`object-position: ${photoPosition};`}
    />
  ) : (
    <img class="person-card__avatar" src="/assets/placeholders/avatar.svg" alt="" width="120" height="120" />
  )}
  <h3 class="person-card__name">{name}</h3>
  <p class="person-card__title">{title}</p>
  <slot />
</article>
