---
// Global footer (ported verbatim from the static build; links updated to the
// new directory-style URLs).
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">

      <nav class="footer-nav" aria-label="Quick Navigation">
        <h4>Quick Navigation</h4>
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
      </nav>

      <div class="site-footer__brand">
        <img src="/assets/images/logo-footer.png" alt="MenuAmbition — Better Meals, Better Nutrition, Better Budgets" />
      </div>

      <div class="footer-news">
        <h4>Subscribe to our newsletter</h4>
        <form class="newsletter-form" data-inert novalidate>
          <label class="visually-hidden" for="footer-news-email">Email address</label>
          <input id="footer-news-email" type="email" name="email" placeholder="Email" autocomplete="email" />
          <button type="submit">SUBSCRIBE</button>
        </form>
        <p class="newsletter-note">You can unsubscribe at any time.</p>
        <p class="newsletter-feedback" role="status" aria-live="polite"></p>
      </div>

    </div>

    <div class="site-footer__bar">
      <p>&copy; Certainte LLC |
        <a href="/tos/">Terms of Service</a> |
        <a href="/privacy-policy/">Privacy Policy</a>
      </p>
      <div class="social-links" aria-label="Social media">
        <a href="#" aria-label="X (Twitter)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg>
        </a>
        <a href="#" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.9h-2.34V22c4.78-.76 8.43-4.92 8.43-9.94Z"/></svg>
        </a>
        <a href="#" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
