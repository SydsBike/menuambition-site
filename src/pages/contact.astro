---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact — MenuAmbition"
  description="Get in touch with MenuAmbition. Phone 847.323.5571, email rpedi@menuambition.com, 350 North Orleans St, Suite 9000 N, Chicago, IL 60654."
  ogTitle="Contact MenuAmbition"
  ogDescription="Let's talk about better menus. Reach the MenuAmbition team."
>

  <!-- ===================== PAGE HEADER ===================== -->
  <section class="page-header">
    <div class="container">
      <h1>Contact Us</h1>
      <p class="page-header__lead">Tell us about your menus and goals &ndash; we&rsquo;d love to show you what MenuAmbition can do.</p>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section class="section">
    <div class="container contact-layout">

      <!-- Inert contact form (no backend by design) -->
      <form class="contact-form" data-inert data-inert-msg="Preview only — this form isn’t connected." novalidate aria-labelledby="contact-form-heading">
        <h2 id="contact-form-heading" class="visually-hidden">Contact form</h2>

        <div class="field-row">
          <div class="field">
            <label for="first-name">First Name</label>
            <input type="text" id="first-name" name="first_name" autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="last-name">Last Name</label>
            <input type="text" id="last-name" name="last_name" autocomplete="family-name" />
          </div>
        </div>

        <div class="field">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" autocomplete="email" />
        </div>

        <div class="field">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="message">Your Message / Comment</label>
          <textarea id="message" name="message" rows="6"></textarea>
        </div>

        <button type="submit" class="btn-primary">Submit</button>
        <p class="form-note" role="status" aria-live="polite"></p>
      </form>

      <!-- Contact details -->
      <aside class="contact-details">
        <h2>Contact Details</h2>

        <div class="contact-detail">
          <span class="contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.9 15.9 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1l-2.23 2.2Z"/></svg>
          </span>
          <p class="contact-detail__text">
            <a href="tel:+18473235571">847.323.5571</a>
          </p>
        </div>

        <div class="contact-detail">
          <span class="contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v.4l8 5 8-5V6H4Zm16 2.7-7.47 4.67a1 1 0 0 1-1.06 0L4 8.7V18h16V8.7Z"/></svg>
          </span>
          <p class="contact-detail__text">
            <a href="mailto:rpedi@menuambition.com">rpedi@menuambition.com</a>
          </p>
        </div>

        <div class="contact-detail">
          <span class="contact-detail__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
          </span>
          <p class="contact-detail__text">
            350 North Orleans St, Suite 9000 N,<br />Chicago, IL 60654
          </p>
        </div>
      </aside>

    </div>
  </section>

</BaseLayout>
