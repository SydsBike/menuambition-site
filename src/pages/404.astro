---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found — MenuAmbition"
  description="The page you're looking for doesn't exist or may have moved."
>

  <!-- ===================== PAGE HEADER ===================== -->
  <section class="page-header">
    <div class="container">
      <h1>Page not found</h1>
      <p class="page-header__lead">The page you&rsquo;re looking for doesn&rsquo;t exist or may have moved.</p>
    </div>
  </section>

  <!-- ===================== WAYS BACK ===================== -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <p>Here are a few places to pick back up:</p>
      <p>
        <a class="btn-primary" href="/">Back to Home</a>
      </p>
      <p>
        <a class="related-link" href="/blog/">Browse our Resources</a><br />
        <a class="related-link" href="/contact/">Let&rsquo;s Talk</a>
      </p>
    </div>
  </section>

</BaseLayout>
